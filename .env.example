# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/rag_db

# Google API Key for Gemini 1.5 flash
GOOGLE_API_KEY=your_google_api_key_here

# Embeddings Configuration
EMBEDDING_MODEL=models/embedding-001
VECTOR_DIM=1536
EMBEDDINGS_BATCH_SIZE=64

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your_secret_key_here

# App Configuration
DEFAULT_REGION=Sverige
LOG_LEVEL=INFO

# Slack/Teams Webhook URLs (for proactive notifications)
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
TEAMS_WEBHOOK_URL=your_teams_webhook_url_here

# Ingestion paths
UPLOAD_FOLDER=./uploads
RAW_DOCX=./data/raw/offices.docx
CSV_INTERIM=./data/interim/offices.normalized.csv
CSV_FINAL=./data/processed/offices.final.csv

# Docker Configuration
COMPOSE_PROJECT_NAME=rainbow6-rag
